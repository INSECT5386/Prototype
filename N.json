{
    "최소주의 인공어": {
        "어근": [
            "san : 힘이 가해지는",
            "tiet : 열이 발생하는, 효율성이 낮은",
            "cone : (구멍이 있는, 열려있는), (관측된, 결정된)",
            "mas : (같은, 다양성 없는), (곧은, 직선, 선형)",
            "cana : 섞인, 통합된, (상태, 정보)",
            "pit : 속도",
            "ilace : 큰, 거시적인",
            "onci : 무게, 물질, 변환된 물질(에너지)",
            "ton : 의 반의어, 공백"
        ],
        "규칙": {
            "A tu B": "A(주어) B(을 향하여/의 형태로) 변화하다/운동하다",
            "1": "전치수식을 사용하며 어근끼리 직접 결합을 금지한다",
            "2": "모든 개념은 어근의 조합으로 표현한다",
            "예문": [
                "san onci pit tu ton : 힘이 가해지는 물질의 속도는 (공백)의 형태로 변화함",
                "cana onci cana tu mas ton, tiet : 섞인 물질의 상태는 다양성 없는 것이 아닌 것의 형태로 변화하고, 열이 발생함"
            ]
        }
    }
}
